#!/usr/bin/env python3
"""Configure repository-local HTTPS authentication without changing work settings."""
from pathlib import Path
import shlex
import subprocess

root = Path(__file__).resolve().parent.parent

def git(*args):
    return subprocess.run(['git', '-C', str(root), *args], check=True)

# An empty first helper prevents fallback to inherited work credential helpers.
git('config', '--local', '--replace-all', 'credential.https://github.com.helper', '')
helper = '!' + shlex.quote(str(root / 'scripts/gh-project')) + ' auth git-credential'
git('config', '--local', '--add', 'credential.https://github.com.helper', helper)
print('Configured project-local GitHub HTTPS authentication. Global settings unchanged.')
